{
  "expo": {
    "name": "Academiee",
    "slug": "academiee",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "academiee",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/4f29464a-c6fd-43ef-895d-ae742074eca0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.academiee.app",
      "buildNumber": "2",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B4BE8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.academiee.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Academiee",
      "themeColor": "#3846C8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#121316"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-font",
        {}
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f29464a-c6fd-43ef-895d-ae742074eca0"
      },
      "supportsRTL": true
    },
    "owner": "devscot.com"
  }
}